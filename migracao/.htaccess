# Aveiro Cult · configuração do servidor (Apache / cPanel)
# Copiado automaticamente pelo migracao/migrar.py para a raiz do site no domínio definitivo.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) Sempre HTTPS e sem "www"
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

# 2) Páginas antigas do WordPress -> páginas novas (mantém o Google e os links partilhados a funcionar)
RewriteRule ^sobre/?$ /sobre.html [R=301,L]
RewriteRule ^os-projetos-do-aveiro-cult/?$ /sobre.html#projetos [R=301,L,NE]
RewriteRule ^(contactos?|contact)/?$ /sobre.html [R=301,L]
RewriteRule ^(eventos?|agenda|listings?|events?)(/.*)?$ /#agenda [R=301,L,NE]
RewriteRule ^(noticias|blog|category|tag)(/.*)?$ /#noticias [R=301,L,NE]
RewriteRule ^(feed|comments/feed)/?$ / [R=301,L]
RewriteRule ^(politica-de-privacidade|privacy-policy)/?$ /privacidade.html [R=301,L]
RewriteRule ^(wp-admin|wp-login\.php|login)(/.*)?$ /admin.html [R=302,L]
RewriteRule ^wp-content/.* - [G,L]

# 3) As 14 notícias importadas do WordPress
RewriteRule ^noite-do-circo-regressa-ao-museu-de-lamas/?$ /noticia.html?n=noite-do-circo-regressa-ao-museu-de-lamas [R=301,L,NE]
RewriteRule ^mercadinho-de-outono-anima-o-largo-do-mercado-manuel-firmino-de-28-de-outubro-a-1-de-novembro/?$ /noticia.html?n=mercadinho-de-outono-anima-o-largo-do-mercado-manuel-firmino [R=301,L,NE]
RewriteRule ^8a-avenida-volta-a-ser-palco-do-jazz-com-dois-dias-de-musica-talento-e-cultura/?$ /noticia.html?n=8-avenida-volta-a-ser-palco-do-jazz-com-dois-dias-de-musica-talento-e-cultura [R=301,L,NE]
RewriteRule ^ana-moura-atua-nos-festivais-de-outono-2026/?$ /noticia.html?n=ana-moura-atua-nos-festivais-de-outono-2026 [R=301,L,NE]
RewriteRule ^aveiro-em-movimento-promove-debate-sobre-longevidade-e-saude-apos-o-alto-rendimento/?$ /noticia.html?n=aveiro-em-movimento-promove-debate-sobre-longevidade-e-saude-apos-o-alto-rendime [R=301,L,NE]
RewriteRule ^rui-paixao-estreia-em-novembro-um-novo-espetaculo/?$ /noticia.html?n=rui-paixao-estreia-em-novembro-um-novo-espetaculo [R=301,L,NE]
RewriteRule ^festivais-de-outono-2026-abrem-com-orquestra-das-beiras-e-pecas-que-dialogam-entre-artes/?$ /noticia.html?n=festivais-de-outono-2026-abrem-com-orquestra-das-beiras-e-pecas-que-dialogam-ent [R=301,L,NE]
RewriteRule ^tanganho-uma-historia-real-de-coragem-que-marcou-portugal-ganha-vida-em-palco/?$ /noticia.html?n=tanganho-uma-historia-real-de-coragem-que-marcou-portugal-ganha-vida-em-palco [R=301,L,NE]
RewriteRule ^aveiro-techweek-hackathon-2026-tem-inscricoes-abertas-ate-4-de-novembro/?$ /noticia.html?n=aveiro-techweek-hackathon-2026-tem-inscricoes-abertas-ate-4-de-novembro [R=301,L,NE]
RewriteRule ^camara-municipal-de-aveiro-aprova-protocolo-com-a-ahresp-para-a-realizacao-do-evento-o-restauranteao-vivo/?$ /noticia.html?n=camara-de-aveiro-aprova-protocolo-com-a-ahresp-para-o-restaurante-ao-vivo [R=301,L,NE]
RewriteRule ^municipio-de-estarreja-apoia-campanha-que-alerta-para-o-uso-excessivo-do-telemovel-e-do-digital/?$ /noticia.html?n=municipio-de-estarreja-apoia-campanha-que-alerta-para-o-uso-excessivo-do-telemov [R=301,L,NE]
RewriteRule ^festival-da-castanha-de-23-a-25-de-outubro-em-arouca/?$ /noticia.html?n=festival-da-castanha-de-23-a-25-de-outubro-em-arouca [R=301,L,NE]
RewriteRule ^camara-de-agueda-apoia-uniao-de-bandas-de-agueda-na-realizacao-do-festival-uba/?$ /noticia.html?n=camara-de-agueda-apoia-uniao-de-bandas-de-agueda-na-realizacao-do-festival-uba [R=301,L,NE]
RewriteRule ^musica-teatro-e-danca-marcam-o-ultimo-quadrimestre-de-2026-no-teatro-aveirense/?$ /noticia.html?n=musica-teatro-e-danca-marcam-o-ultimo-quadrimestre-de-2026-no-teatro-aveirense [R=301,L,NE]

# 4) Outras notícias antigas do WordPress (endereço /um-titulo-com-hifens/): tenta a notícia nova com o mesmo nome
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9]+(?:-[a-z0-9]+){2,})/?$ /noticia.html?n=$1 [R=301,L,NE]
</IfModule>

# Cache: páginas e service worker sempre frescos; ficheiros com versão (?v=) e imagens guardados 1 ano
<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest)$|^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Segurança
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://otcpgtauymtavygscxfo.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json application/manifest+json image/svg+xml text/xml
</IfModule>
